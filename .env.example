S1_BASE_URL=https://YOUR-TENANT.sentinelone.net
S1_API_TOKEN=PASTE_TOKEN_LOCALLY_DO_NOT_COMMIT
S1_ALLOWED_RULE_IDS=PASTE_APPROVED_RULE_ID

# Keep true until the audit output is validated.
S1_DRY_RUN=true
S1_RUN_ONCE=false
S1_POLL_SECONDS=60
S1_LOOKBACK_MINUTES=15
S1_MAX_UPDATES_PER_CYCLE=20
S1_PAGE_LIMIT=200
S1_REQUEST_TIMEOUT=30
S1_AUDIT_FILE=audit_log.csv
